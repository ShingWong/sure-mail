{
  "name": "@shing.wong/sure-mail-ui",
  "version": "0.1.0",
  "private": true,
  "description": "sure-mail app shell (framework-free h() + plain DOM), the sure-ui skin engine, and core-op-backed entity stores",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "SURE_MAIL_BROWSER_E2E=1 node --test test/browser-app.test.mjs",
    "test:fidelity": "SURE_MAIL_SKIN_FIDELITY=1 node --test test/skin-fidelity.test.mjs",
    "test:visual": "SURE_MAIL_VISUAL=1 node --test test/visual-qa.test.mjs",
    "test:visual:update": "SURE_MAIL_VISUAL=1 SURE_MAIL_VISUAL_UPDATE=1 node --test test/visual-qa.test.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "start": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@shing.wong/sure-mail-flows": "0.1.0",
    "@shing.wong/sure-mail-host-web": "0.1.0",
    "@shing.wong/sure-state": "^0.1.9",
    "@shing.wong/sure-ui": "^0.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright-core": "^1.64.1"
  },
  "license": "MIT"
}
